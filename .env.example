# Copy to .env and edit (or add these to OpenLobby's .env: the override runs
# in OpenLobby's compose project, which reads that file). Every value is
# optional; an EMPTY value means "use the built-in default".

# The core image this title is layered on. Default: openlobby:latest. Set
# crystalmaster:latest (and POL_TITLES below) to run Tetra Master as well.
OPENLOBBY_IMAGE=

# The title plugins the core loads. Default: jantitle. With the CrystalMaster
# image underneath: tmtitle,jantitle.
POL_TITLES=

# Table entry limits (the master's "Money limit", "Level limit", "Title
# limit" rules). Off by default: the limits are stored but not enforced.
# POL_JAN_RESERVE_LIMITS=1 refuses a reservation that misses them; the two
# minimums are what "Money limit" and "Level limit" demand (default 1 each).
POL_JAN_RESERVE_LIMITS=
POL_JAN_LIMIT_MONEY_MIN=
POL_JAN_LIMIT_LEVEL_MIN=

# MjGETLNDVACK channel ids: 1 serves the profile, rank and lobby channel ids
# and lobby domain that Project Crystal Server serves, instead of zeros.
# Needs a core image that carries mgkey.py. Default: zeros.
POL_JAN_LNDV_CHANNELS=

# Live board (--profile board): the public URL the Discord messages link to,
# the webhook the standings post to, and the one live tables post to (empty
# = the standings' channel). Empty = no Discord.
POL_BOARDS_JAN_URL=
POL_BOARDS_JAN_DISCORD_WEBHOOK=
POL_BOARDS_JAN_LIVE_DISCORD_WEBHOOK=

# Optional Discord BOT for the board instead of (or beside) the webhooks: it
# posts with buttons, shows the number of players at the tables as its
# status, and is told where to post with /janboard in each server it is
# invited to, so no webhook is needed. The token is a secret. Empty = no bot.
POL_BOARDS_JAN_DISCORD_BOT_TOKEN=
POL_BOARDS_JAN_DISCORD_APP_ID=
POL_BOARDS_JAN_DISCORD_PUBLIC_KEY=
